{
  "name": "agresh-design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Core UI kit for Agresh Agrawal's portfolio design language — a sophisticated, luxury dark theme with violet accents.",
  "main": "./dist/agresh-design-system.js",
  "module": "./dist/agresh-design-system.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/agresh-design-system.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agresh-design-system.js"
    },
    "./styles.css": "./dist/agresh-design-system.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
